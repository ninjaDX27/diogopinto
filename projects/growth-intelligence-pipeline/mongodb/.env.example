# Copy to .env locally. Never commit .env to GitHub.
# Obtain connection string from MongoDB Atlas → Database → Connect → Drivers.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/
MONGODB_DATABASE=growth_intelligence_dev
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEV_API_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
PORT=8787
BIND_HOST=127.0.0.1
